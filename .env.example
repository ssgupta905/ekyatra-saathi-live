# Copy to .env. Everything is optional: with none of it set, Saathi runs fully
# in-process on synthetic data, which is what `make demo` and CI do.

SAATHI_ENVIRONMENT=local
SAATHI_LOG_LEVEL=INFO
# Demo controls (simulator-driven clock, reset). Refused when ENVIRONMENT=production.
SAATHI_SIM_MODE=false
# "Today" is the hospital's date, not the server's.
SAATHI_HOSPITAL_TIMEZONE=Asia/Kolkata
# Reference data. Empty = the checkout's data/ (or ./data). Always made absolute.
SAATHI_DATA_DIR=

# --- language layer ---
# Without either key the planner still decides go/wait; it just does not write
# the message, and the live world still ticks. Groq wins when both are present:
# the live demo needs its latency, and it is the only one with strict
# structured outputs fast enough to render inside a tick.
GROQ_API_KEY=
SAATHI_GROQ_MODEL=openai/gpt-oss-20b
SAATHI_GROQ_ACTOR_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
SAATHI_CLAUDE_MODEL=claude-opus-5

# --- the live world ---
# Real seconds per simulated day; which families get live rendering and actors;
# how long a desk candidate waits before it is assumed confirmed; how often the
# caregiver actor writes in; how many days to rewind at startup so reports land
# while someone is watching.
SAATHI_LIVE_SECONDS_PER_DAY=4.0
SAATHI_LIVE_WATCHED=8
SAATHI_LIVE_AUTO_CONFIRM_TICKS=2
SAATHI_LIVE_INBOUND_EVERY_SECONDS=15
SAATHI_LIVE_START_OFFSET_DAYS=3
SAATHI_LIVE_AUTOSTART=false

# --- readiness model ---
# 1 - alpha is the coverage guarantee on readiness windows.
SAATHI_CONFORMAL_ALPHA=0.1
SAATHI_TRAVEL_LEAD_DAYS=1

# --- storage ---
SAATHI_DATABASE_URL=sqlite+aiosqlite:///./saathi.db
# SAATHI_DATABASE_URL=postgresql+asyncpg://saathi:saathi@localhost:5432/saathi
SAATHI_NEO4J_URI=
SAATHI_NEO4J_USER=
SAATHI_NEO4J_PASSWORD=

# --- health data ---
SAATHI_ABDM_BASE_URL=
SAATHI_ABDM_CLIENT_ID=
SAATHI_ABDM_CLIENT_SECRET=
SAATHI_HOSPITAL_FEED_URL=

# --- the hospital management system ---
# Root of the Bahmni install, without the /openmrs path. Leave blank and the
# desks are the feed: staff enter status in the console, which is where the
# pilot starts anyway. Set all three and the connector polls for real.
SAATHI_BAHMNI_BASE_URL=
SAATHI_BAHMNI_USERNAME=
SAATHI_BAHMNI_PASSWORD=
# Bahmni appointments carry no dateChanged, so every poll re-reads the whole
# window. These two knobs are the cost of that.
SAATHI_BAHMNI_POLL_SECONDS=3.0
SAATHI_BAHMNI_WINDOW_DAYS=30
# Results come over FHIR, which does support _lastUpdated, so this side is a
# cheap cursor query and does not need the appointment cadence.
SAATHI_BAHMNI_CLINICAL_POLL_SECONDS=15.0

# --- more than one hospital ---
# One entry per hospital that has a system to read:
#   <hospital id>=<kind>|<base url>[|user|password]
# Kinds: `bahmni` (its own REST API) and `fhir` (plain FHIR R4, e.g. HAPI).
# Comma-separated; a JSON array works too. A hospital absent from this list
# has no system to read, which is not a failure — its desks are the feed.
#
# This supersedes the single SAATHI_BAHMNI_* block above, which is kept as a
# one-hospital shorthand so existing deployments keep working.
#
# SAATHI_HOSPITAL_SYSTEMS=TMH-MUM=bahmni|https://hms.example.org|user|pass,GAYA-DH=fhir|https://fhir.example.org/fhir
#
# OpenEMR takes neither a password nor a client secret for system access: it
# signs a JWT assertion with a private key. Only the key's *path* goes here —
# a private key pasted into a deployment variable ends up in logs, dashboards
# and shoulder-surfing range.
#   H1=openemr|<base url>|<client id>|<key id>|<pem path>
#
# Optionally append a read-only database, for the one signal OpenEMR does not
# project over FHIR: how far behind the clinic is running. All three parts are
# required together. Leave them off and the Console reports that a family
# arrived and claims no delay, which is the honest answer. See docs/openemr.md.
#   H1=openemr|<base url>|<client id>|<key id>|<pem path>|localhost:3306/openemr|<db user>|<db pass>
SAATHI_HOSPITAL_SYSTEMS=

# --- reaching the family ---
SAATHI_WHATSAPP_PHONE_NUMBER_ID=
SAATHI_WHATSAPP_TOKEN=
SAATHI_EXOTEL_SID=
SAATHI_EXOTEL_TOKEN=
# Sarvam: speech in Indian languages. First choice for hearing a family, and
# the only way the app can speak at all — no browser ships an Odia voice, so
# without this the read-aloud button does nothing for an Odia family.
# Note the name: SARVAM_KEY, not under the SAATHI_ prefix.
SARVAM_KEY=
SAATHI_SARVAM_LISTEN_MODEL=saarika:v2.5
SAATHI_SARVAM_SPEAK_MODEL=bulbul:v3

SAATHI_BHASHINI_API_KEY=
SAATHI_BHASHINI_USER_ID=

# --- the real world (see README: Real records) ---
# demo = generated cohort and a fast clock; real = a hospital's own records.
SAATHI_WORLD=demo
SAATHI_RECORDS_URL=sqlite:///./saathi_records.db
# auto = login on in the real world, off in the demo. Set a long random secret in any shared deployment.
SAATHI_AUTH=auto
# SAATHI_AUTH_SECRET=
SAATHI_IDENTITY_PROVIDER=local
