# Copy to .env. Everything is optional: with none of it set, Saathi runs fully
# in-process on synthetic data, which is what `make demo` and CI do.

SAATHI_ENVIRONMENT=local
SAATHI_LOG_LEVEL=INFO
# Demo controls (simulator-driven clock, reset). Refused when ENVIRONMENT=production.
SAATHI_SIM_MODE=false
# "Today" is the hospital's date, not the server's.
SAATHI_HOSPITAL_TIMEZONE=Asia/Kolkata
# Reference data. Empty = the checkout's data/ (or ./data). Always made absolute.
SAATHI_DATA_DIR=

# --- language layer ---
# Without either key the planner still decides go/wait; it just does not write
# the message, and the live world still ticks. Groq wins when both are present:
# the live demo needs its latency, and it is the only one with strict
# structured outputs fast enough to render inside a tick.
GROQ_API_KEY=
SAATHI_GROQ_MODEL=openai/gpt-oss-20b
SAATHI_GROQ_ACTOR_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
SAATHI_CLAUDE_MODEL=claude-opus-5

# --- the live world ---
# Real seconds per simulated day; which families get live rendering and actors;
# how long a desk candidate waits before it is assumed confirmed; how often the
# caregiver actor writes in; how many days to rewind at startup so reports land
# while someone is watching.
SAATHI_LIVE_SECONDS_PER_DAY=4.0
SAATHI_LIVE_WATCHED=8
SAATHI_LIVE_AUTO_CONFIRM_TICKS=2
SAATHI_LIVE_INBOUND_EVERY_SECONDS=15
SAATHI_LIVE_START_OFFSET_DAYS=3
SAATHI_LIVE_AUTOSTART=false

# --- readiness model ---
# 1 - alpha is the coverage guarantee on readiness windows.
SAATHI_CONFORMAL_ALPHA=0.1
SAATHI_TRAVEL_LEAD_DAYS=1

# --- storage ---
SAATHI_DATABASE_URL=sqlite+aiosqlite:///./saathi.db
# SAATHI_DATABASE_URL=postgresql+asyncpg://saathi:saathi@localhost:5432/saathi
SAATHI_NEO4J_URI=
SAATHI_NEO4J_USER=
SAATHI_NEO4J_PASSWORD=

# --- health data ---
SAATHI_ABDM_BASE_URL=
SAATHI_ABDM_CLIENT_ID=
SAATHI_ABDM_CLIENT_SECRET=
SAATHI_HOSPITAL_FEED_URL=

# --- reaching the family ---
SAATHI_WHATSAPP_PHONE_NUMBER_ID=
SAATHI_WHATSAPP_TOKEN=
SAATHI_EXOTEL_SID=
SAATHI_EXOTEL_TOKEN=
SAATHI_BHASHINI_API_KEY=
SAATHI_BHASHINI_USER_ID=

# --- the real world (see README: Real records) ---
# demo = generated cohort and a fast clock; real = a hospital's own records.
SAATHI_WORLD=demo
SAATHI_RECORDS_URL=sqlite:///./saathi_records.db
# auto = login on in the real world, off in the demo. Set a long random secret in any shared deployment.
SAATHI_AUTH=auto
# SAATHI_AUTH_SECRET=
SAATHI_IDENTITY_PROVIDER=local
