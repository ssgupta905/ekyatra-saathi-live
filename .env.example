# Copy to .env. Everything is optional: with none of it set, Saathi runs fully
# in-process on synthetic data, which is what `make demo` and CI do.

SAATHI_ENVIRONMENT=local
SAATHI_LOG_LEVEL=INFO

# --- language layer ---
# Without this the planner still decides go/wait; it just does not write the message.
ANTHROPIC_API_KEY=
SAATHI_CLAUDE_MODEL=claude-opus-5

# --- readiness model ---
# 1 - alpha is the coverage guarantee on readiness windows.
SAATHI_CONFORMAL_ALPHA=0.1
SAATHI_TRAVEL_LEAD_DAYS=1

# --- storage ---
SAATHI_DATABASE_URL=sqlite+aiosqlite:///./saathi.db
# SAATHI_DATABASE_URL=postgresql+asyncpg://saathi:saathi@localhost:5432/saathi
SAATHI_NEO4J_URI=
SAATHI_NEO4J_USER=
SAATHI_NEO4J_PASSWORD=

# --- health data ---
SAATHI_ABDM_BASE_URL=
SAATHI_ABDM_CLIENT_ID=
SAATHI_ABDM_CLIENT_SECRET=
SAATHI_HOSPITAL_FEED_URL=

# --- reaching the family ---
SAATHI_WHATSAPP_PHONE_NUMBER_ID=
SAATHI_WHATSAPP_TOKEN=
SAATHI_EXOTEL_SID=
SAATHI_EXOTEL_TOKEN=
SAATHI_BHASHINI_API_KEY=
SAATHI_BHASHINI_USER_ID=
