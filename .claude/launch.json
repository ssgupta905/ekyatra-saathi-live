{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "control-centre",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend/apps/control-centre",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "family-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend/apps/family-web",
        "run",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "demo-stage",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend/apps/demo-stage",
        "run",
        "dev"
      ],
      "port": 5190
    },
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a; [ -f .env ] && source .env; set +a; exec .venv/bin/uvicorn saathi.main:app --app-dir backend --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 2"
      ],
      "port": 8000
    }
  ]
}