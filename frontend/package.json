{
  "name": "saathi-frontend",
  "private": true,
  "type": "module",
  "description": "Every Saathi front end: shared packages and the apps built on them.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9",
    "@types/node": "^22.10.0"
  }
}
